# ─── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Option A — single connection URL (preferred for cloud / production).
# When DB_URL is set, the individual DB_* vars below are ignored by the app.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Supabase example: postgres://postgres.xyz:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DB_URL=

# Option B — individual variables (used when DB_URL is absent, typical for local dev).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=internsync_dev
DB_USER=postgres
DB_PASSWORD=yourpassword
# Set to true when connecting to a cloud Postgres that requires TLS
# (Supabase, Neon, Railway, Render, AWS RDS). Leave false for local dev.
DB_SSL=false

# ─── JWT ─────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_64_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email / SMTP ─────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM="InternSync <no-reply@internsync.dev>"

# (Alternative) Resend / SendGrid
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cloudinary ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── AWS S3 (alternative to Cloudinary) ──────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=internsync-uploads

# ─── Feature Flags ────────────────────────────────────────────────
# Set to true to skip admin moderation step for new listings
AUTO_APPROVE_LISTINGS=false

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── CORS ─────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Cookie ───────────────────────────────────────────────────────
COOKIE_SECRET=replace_with_random_secret_for_cookie_signing

# ─── Sentry (optional error tracking) ────────────────────────────
SENTRY_DSN=https://your_key@sentry.io/your_project_id
